{
  "name": "dice-game",
  "version": "1.0.0",
  "description": "A TypeScript-based browser game using Webpack and Yarn",
  "main": "src/index.ts",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:engine": "vitest run \"engine/test/**/*.test.ts\" \"engine/test/**/*.test.js\"",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:silent": "vitest run --reporter=silent --silent"
  },
  "vitest": {
    "test": {
      "environment": "jsdom",
      "globals": true,
      "setupFiles": ["tests/vitest.setup.ts"]
    }
  },
  "dependencies": {
    "chroma-js": "^3.1.2",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/chroma-js": "^3.1.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^27.0.0",
    "@types/three": "^0.178.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^29.7.0",
    "jsdom": "^27.3.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.0.16",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.0.0"
  },
  "author": "",
  "license": "ISC"
}
